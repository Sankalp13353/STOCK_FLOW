# Application Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Connection Strings
# Pooled connection string (used by Prisma Client / Application)
DATABASE_URL="postgresql://user:password@pooler-host:5432/stockflow_db?sslmode=require"

# Direct connection string (used by Prisma for migrations)
DIRECT_URL="postgresql://user:password@direct-host:5432/stockflow_db?sslmode=require"

# JWT Secret & Expiration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# CORS Origin
CORS_ORIGIN="*"

# RabbitMQ Message Broker Configuration
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_EXCHANGE="stockflow.events"
RABBITMQ_DLX="stockflow.dlx"

# Redis In-Memory Store & Caching
REDIS_URL="redis://localhost:6379"
CACHE_TTL=60

# Redis-Backed Distributed Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Initial Administrator Bootstrap (used by `npm run admin:bootstrap`)
# ADMIN_NAME="StockFlow Administrator"
# ADMIN_EMAIL="admin@stockflow.dev"
# ADMIN_PASSWORD="SecureAdminPassword123!"
