datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  WAREHOUSE_STAFF
  WAREHOUSE_MANAGER
  ADMIN
}

enum MovementType {
  RESTOCK
  RESERVATION_HOLD
  RESERVATION_RELEASE
  FULFILLMENT_DEDUCTION
  AUDIT_ADJUSTMENT
}

enum OrderStatus {
  PENDING
  RESERVED
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  RESERVATION_EXPIRED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ProcessedEventStatus {
  IN_PROGRESS
  COMPLETED
}

enum TicketType {
  ORDER_SHORTAGE
  CUSTOMER_DECISION
  LOW_STOCK
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  CLOSED
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomerDecision {
  PENDING
  ACCEPTED_PARTIAL
  REJECTED
  EXPIRED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_SHORTAGE
  CUSTOMER_DECISION_REQUIRED
  LOW_STOCK_ALERT
  TICKET_ASSIGNED
  TICKET_RESOLVED
  ORDER_APPROVED
  ORDER_REJECTED
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  email                String                    @unique(map: "idx_users_email") @db.VarChar(255)
  passwordHash         String                    @map("password_hash") @db.VarChar(255)
  fullName             String                    @map("full_name") @db.VarChar(100)
  role                 UserRole                  @default(CUSTOMER)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  orders               Order[]
  warehouseAssignments UserWarehouseAssignment[]
  customerTickets      Ticket[]                  @relation("CustomerTickets")
  assignedTickets      Ticket[]                  @relation("AssignedTickets")
  approvedTickets      Ticket[]                  @relation("ApprovedTickets")
  notifications        Notification[]

  @@map("users")
}

model Warehouse {
  id                 String                    @id @default(uuid()) @db.Uuid
  code               String                    @unique(map: "idx_warehouses_code") @db.VarChar(50)
  name               String                    @db.VarChar(150)
  address            String                    @db.VarChar(255)
  city               String                    @db.VarChar(100)
  country            String                    @db.VarChar(100)
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  userAssignments    UserWarehouseAssignment[]
  thresholds         MinimumStockThreshold[]
  tickets            Ticket[]

  @@map("warehouses")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  sku                String              @unique(map: "idx_products_sku") @db.VarChar(100)
  name               String              @db.VarChar(200)
  description        String?             @db.Text
  priceCents         Int                 @map("price_cents")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  thresholds         MinimumStockThreshold[]
  tickets            Ticket[]

  @@index([isActive], map: "idx_products_active")
  @@map("products")
}

model Inventory {
  id               String                 @id @default(uuid()) @db.Uuid
  productId        String                 @map("product_id") @db.Uuid
  warehouseId      String                 @map("warehouse_id") @db.Uuid
  quantityOnHand   Int                    @default(0) @map("quantity_on_hand")
  quantityReserved Int                    @default(0) @map("quantity_reserved")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservations     InventoryReservation[]

  @@unique([productId, warehouseId], map: "uq_inventory_product_warehouse")
  @@index([warehouseId], map: "idx_inventory_warehouse")
  @@map("inventory")
}

model InventoryMovement {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  warehouseId   String       @map("warehouse_id") @db.Uuid
  quantityDelta Int          @map("quantity_delta")
  movementType  MovementType @map("movement_type")
  referenceId   String?      @map("reference_id") @db.Uuid
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId], map: "idx_inv_movements_prod_wh")
  @@index([referenceId], map: "idx_inv_movements_ref")
  @@index([createdAt], map: "idx_inv_movements_created")
  @@map("inventory_movements")
}

model Order {
  id                    String                 @id @default(uuid()) @db.Uuid
  orderNumber           String                 @unique(map: "idx_orders_order_number") @map("order_number") @db.VarChar(50)
  userId                String                 @map("user_id") @db.Uuid
  status                OrderStatus            @default(PENDING)
  totalAmountCents      Int                    @map("total_amount_cents")
  idempotencyKey        String?                @unique(map: "idx_orders_idempotency_key") @map("idempotency_key") @db.VarChar(255)
  shippingAddress       String                 @map("shipping_address") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]
  payments              Payment[]
  tickets               Ticket[]
  notifications         Notification[]

  @@index([userId], map: "idx_orders_user_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  quantity       Int
  unitPriceCents Int       @map("unit_price_cents")
  subtotalCents  Int       @map("subtotal_cents")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  inventoryId String            @map("inventory_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_reservations_order_id")
  @@index([inventoryId], map: "idx_reservations_inventory_id")
  @@index([status, expiresAt], map: "idx_reservations_expiry")
  @@map("inventory_reservations")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  amountCents          Int           @map("amount_cents")
  status               PaymentStatus @default(PENDING)
  paymentMethod        String        @map("payment_method") @db.VarChar(50)
  transactionReference String        @unique(map: "idx_payments_tx_ref") @map("transaction_reference") @db.VarChar(100)
  failureReason        String?       @map("failure_reason") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_payments_order_id")
  @@map("payments")
}

model IdempotencyRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  key                String    @unique(map: "idx_idempotency_key") @db.VarChar(255)
  requestPath        String    @map("request_path") @db.VarChar(255)
  requestPayloadHash String    @map("request_payload_hash") @db.VarChar(64)
  responseStatus     Int       @map("response_status")
  responseBody       Json      @map("response_body")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("idempotency_records")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error") @db.Text
  retryAfter    DateTime?    @map("retry_after") @db.Timestamptz
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt], map: "idx_outbox_status_created")
  @@index([aggregateType, aggregateId], map: "idx_outbox_aggregate")
  @@map("outbox_events")
}

model ProcessedEvent {
  id           String               @id @default(uuid()) @db.Uuid
  eventId      String               @map("event_id") @db.VarChar(255)
  consumerName String               @map("consumer_name") @db.VarChar(100)
  eventType    String               @map("event_type") @db.VarChar(100)
  status       ProcessedEventStatus @default(IN_PROGRESS)
  claimToken   String?              @map("claim_token") @db.Uuid
  lockedAt     DateTime             @default(now()) @map("locked_at") @db.Timestamptz
  processedAt  DateTime?            @map("processed_at") @db.Timestamptz
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([eventId, consumerName], map: "uq_processed_events_event_consumer")
  @@index([consumerName, status], map: "idx_processed_events_consumer_status")
  @@map("processed_events")
}

model UserWarehouseAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  role        UserRole?
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId], map: "uq_user_warehouse")
  @@index([userId], map: "idx_user_warehouse_user")
  @@index([warehouseId], map: "idx_user_warehouse_warehouse")
  @@map("user_warehouse_assignments")
}

model MinimumStockThreshold {
  id              String     @id @default(uuid()) @db.Uuid
  productId       String     @map("product_id") @db.Uuid
  warehouseId     String?    @map("warehouse_id") @db.Uuid
  minQuantity     Int        @default(10) @map("min_quantity")
  reorderQuantity Int?       @default(0) @map("reorder_quantity")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId], map: "uq_threshold_product_warehouse")
  @@index([productId], map: "idx_threshold_product")
  @@index([warehouseId], map: "idx_threshold_warehouse")
  @@map("minimum_stock_thresholds")
}

model Ticket {
  id                 String           @id @default(uuid()) @db.Uuid
  ticketNumber       String           @unique(map: "idx_tickets_ticket_number") @map("ticket_number") @db.VarChar(50)
  type               TicketType
  status             TicketStatus     @default(OPEN)
  priority           TicketPriority   @default(MEDIUM)
  orderId            String?          @map("order_id") @db.Uuid
  customerId         String?          @map("customer_id") @db.Uuid
  productId          String?          @map("product_id") @db.Uuid
  warehouseId        String?          @map("warehouse_id") @db.Uuid
  requestedQuantity  Int?             @map("requested_quantity")
  availableQuantity  Int?             @map("available_quantity")
  shortageQuantity   Int?             @map("shortage_quantity")
  quantityOffered    Int?             @map("quantity_offered")
  thresholdQuantity  Int?             @map("threshold_quantity")
  deficitQuantity    Int?             @map("deficit_quantity")
  customerDecision   CustomerDecision? @map("customer_decision")
  decisionDeadline   DateTime?        @map("decision_deadline") @db.Timestamptz
  approvalStatus     ApprovalStatus   @default(NOT_REQUIRED) @map("approval_status")
  approvedByUserId   String?          @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz
  assignedToUserId   String?          @map("assigned_to_user_id") @db.Uuid
  parentTicketId     String?          @map("parent_ticket_id") @db.Uuid
  resolutionNotes    String?          @map("resolution_notes") @db.Text
  metadata           Json?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt         DateTime?        @map("resolved_at") @db.Timestamptz

  order              Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer           User?            @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: SetNull)
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  assignedToUser     User?            @relation("AssignedTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  approvedByUser     User?            @relation("ApprovedTickets", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  parentTicket       Ticket?          @relation("LinkedTickets", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets       Ticket[]         @relation("LinkedTickets")
  notifications      Notification[]

  @@index([type, status], map: "idx_tickets_type_status")
  @@index([orderId], map: "idx_tickets_order_id")
  @@index([customerId], map: "idx_tickets_customer_id")
  @@index([productId, warehouseId], map: "idx_tickets_prod_wh")
  @@index([assignedToUserId], map: "idx_tickets_assigned_user")
  @@map("tickets")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  ticketId  String?          @map("ticket_id") @db.Uuid
  orderId   String?          @map("order_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  dedupKey  String?          @unique(map: "idx_notifications_dedup") @map("dedup_key") @db.VarChar(255)
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead], map: "idx_notifications_user_unread")
  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@map("notifications")
}

